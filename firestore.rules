rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 自分だけを追加する「自己参加」かどうか。
    // memberIds・members の両方がちょうど1人（=自分）だけ増え、既存メンバーは
    // 全保持（hasAll）、保護フィールドは不変、人数は上限以内であること。
    function isSelfJoin() {
      return !(request.auth.uid in resource.data.memberIds)
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.memberIds.hasAll(resource.data.memberIds)
        && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
        && request.resource.data.memberIds.size() <= resource.data.memberLimit
        && request.resource.data.members.hasAll(resource.data.members)
        && request.resource.data.members.size() == resource.data.members.size() + 1
        && request.resource.data.name == resource.data.name
        && request.resource.data.isPremium == resource.data.isPremium
        && request.resource.data.memberLimit == resource.data.memberLimit;
    }

    match /groups/{groupId} {
      allow read, delete: if request.auth != null
        && request.auth.uid in resource.data.memberIds;

      // 作成者は自分を memberIds に含め、初期人数は上限以内であること。
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.memberIds.size() <= request.resource.data.memberLimit;

      // 既存メンバーは編集可。非メンバーは自己参加のみ許可。
      allow update: if request.auth != null
        && (request.auth.uid in resource.data.memberIds || isSelfJoin());

      match /tasks/{taskId} {
        allow read, write: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
      }
    }

    // 招待コード → groupId の対応表。
    // 認証済みなら誰でも引ける（コードを知っている＝招待された人）。
    // 発行はそのグループのメンバーのみ。書き換え/削除は不可。
    match /invites/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.auth.uid in get(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.memberIds;
      allow update, delete: if false;
    }
  }
}
